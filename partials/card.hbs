{{!-- The collection card. One skeleton; the collection's own tag picks the
     device. Use inside {{#foreach posts}}. --}}
<article class="c
	{{#has tag="hash-video"}}c-video{{/has}}
	{{#has tag="hash-blog"}}c-blog{{/has}}
	{{#has tag="hash-project"}}c-project{{/has}}
	{{#has tag="hash-course"}}c-course{{/has}}
	{{#has tag="hash-webseries"}}c-series{{/has}}
	{{#has tag="hash-episode"}}c-episode{{/has}}
	{{#has tag="hash-newsletter"}}c-newsletter{{/has}}
	{{#has tag="hash-snippet"}}c-snippet{{/has}}
	{{#has tag="hash-prompt"}}c-prompt{{/has}}
	{{#has tag="hash-trip"}}c-trip{{/has}}
	{{#has tag="hash-travel"}}c-travel{{/has}}
	{{#has tag="hash-experience"}}c-experience{{/has}}
	{{#has tag="hash-guide"}}c-guide{{/has}}">

	{{#if feature_image}}
		<div class="c__media">
			<img src="{{img_url feature_image size="m"}}"
			     srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w"
			     sizes="(min-width: 62rem) 19rem, 100vw"
			     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
			     class="object-cover" loading="lazy" width="600" height="338" />
		</div>
	{{/if}}

	<div class="c__body">
		{{#if primary_tag}}
			<p class="c__meta"><span class="dot dot-sm"></span> {{primary_tag.name}}</p>
		{{/if}}

		<h2 class="c__title"><a class="c__link" href="{{url}}">{{title}}</a></h2>

		{{#if custom_excerpt}}
			<p class="c__excerpt">{{custom_excerpt}}</p>
		{{else}}
			<p class="c__excerpt">{{excerpt words="22"}}</p>
		{{/if}}
	</div>

	<div class="c__foot">
		<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
		<span>{{reading_time}}</span>
	</div>
</article>
