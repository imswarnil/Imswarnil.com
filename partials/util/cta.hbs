{{!-- The one ask. Drop at the end of any layout that wants it. --}}
<section class="container section">
	<div class="cta cta-newsletter pattern pattern-grid" data-surface="inverse">
		<span class="cta__kicker">
			<svg class="icon" aria-hidden="true" style="width:1rem;height:1rem"><use href="#i-mail"/></svg>
			The newsletter
		</span>
		<h2 class="cta__title">Get the build log in your <em>inbox</em>.</h2>
		<p class="cta__body">One email a week. What shipped, what broke, what I'd do differently.</p>
		<form class="cta-newsletter__form" data-members-form="subscribe">
			<input class="input" type="email" name="email" placeholder="you@domain.com" aria-label="Email" required />
			<button class="btn btn-primary" type="submit">Subscribe</button>
		</form>
		<p class="cta__fine">No spam. Unsubscribe in one click.</p>
	</div>
</section>
