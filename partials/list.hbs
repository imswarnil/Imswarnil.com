{{!-- Collection index: a deck of the collection's own cards, plus pagination. --}}
<section class="container section">
	{{#if posts}}
		<div class="deck-c sec-cascade sec-on-scroll">
			{{#foreach posts}}
				{{> card}}
			{{/foreach}}
		</div>
		{{> pagination}}
	{{else}}
		<div class="empty">
			<span class="eyebrow">Nothing here yet</span>
			<p class="empty__title">This shelf is still being filled</p>
			<p class="empty__body">New work lands most weeks — the newsletter is the fastest way to hear about it.</p>
			<a class="btn btn-soft" href="#/portal/signup">Notify me</a>
		</div>
	{{/if}}
</section>
