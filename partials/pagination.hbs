{{#if pagination.total}}
	<nav class="pagination" aria-label="Pagination">
		{{#if prev}}
			<a class="btn btn-ghost btn-sm fx-shift" href="{{page_url prev}}"><span class="fx-shift__icon">←</span> Newer</a>
		{{else}}
			<span></span>
		{{/if}}

		<span class="pagination__pages">Page {{page}} of {{pages}}</span>

		{{#if next}}
			<a class="btn btn-ghost btn-sm fx-shift" href="{{page_url next}}">Older <span class="fx-shift__icon">→</span></a>
		{{else}}
			<span></span>
		{{/if}}
	</nav>
{{/if}}
