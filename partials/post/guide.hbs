{{!-- Guide landing: the route, laid out end to end. --}}
<div class="container section">
	<header class="page-head" style="padding-top:0">
		<span class="page-head__kicker"><svg class="icon" aria-hidden="true"><use href="#i-book"/></svg> Guide</span>
		<h1 class="page-head__title">{{title}}</h1>
		{{#if custom_excerpt}}<p class="page-head__desc">{{custom_excerpt}}</p>{{/if}}
	</header>

	<div class="grid-rail u-mt-8">
		<div>
			{{> post-body}}

			{{#if primary_tag}}
				{{#get "posts" filter="tag:hash-guide-content+primary_tag:{{primary_tag.slug}}" limit="100" order="published_at asc" as |steps|}}
					{{#if steps}}
						<ol class="buildlog u-mt-10">
							{{#foreach steps}}
								<li class="buildlog__step"{{#if @first}} data-kind="start"{{/if}}>
									<span class="buildlog__node">{{#unless @first}}{{@number}}{{/unless}}</span>
									<a class="buildlog__link" href="{{url}}">{{title}}
										<span class="buildlog__date">Step {{@number}}</span>
									</a>
								</li>
							{{/foreach}}
						</ol>
					{{/if}}
				{{/get}}
			{{/if}}
		</div>

		<aside class="rail">
			<div class="rail__block">
				<h2 class="rail__title">The route</h2>
				<p class="t-small u-fg-subtle">Follow the steps in order, or jump to the one you need.</p>
			</div>
		</aside>
	</div>
</div>
