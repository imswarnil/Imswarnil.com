{{!< default}}

{{> page-header kicker="Index" title="Tags" description="Everything on the site, grouped. The biggest shelves first."}}

<section class="container section">
	{{#get "tags" limit="100" filter="visibility:public" include="count.posts" order="count.posts desc" as |all_tags|}}
		<div class="cluster">
			{{#foreach all_tags}}
				{{#if count.posts}}
					<a class="c c-tag" href="{{url}}">
						<span class="dot dot-sm{{#unless @first}} dot-muted{{/unless}}"></span>
						<span class="c__title t-small">{{name}}</span>
						<span class="c__count">{{count.posts}}</span>
					</a>
				{{/if}}
			{{/foreach}}
		</div>
	{{/get}}
</section>
