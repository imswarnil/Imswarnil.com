{
	"name": "swarnil",
	"version": "1.1.0",
	"description": "Swarnil — a monochrome, pattern-rich personal OS for Ghost. Videos, blog, projects, courses, webseries, timeline, changelog, resume & more. Built with Tailwind CSS, PWA-ready, JSON-LD everywhere.",
	"keywords": [
		"ghost",
		"theme",
		"ghost-theme",
		"tailwindcss",
		"pwa"
	],
	"author": {
		"name": "Swarnil Singhai",
		"email": "swarnilsinghaicse@gmail.com",
		"url": "https://imswarnil.com"
	},
	"license": "MIT",
	"scripts": {
		"dev:css": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/built/screen.css --watch",
		"dev": "concurrently -n css,sync,lab -c cyan,magenta,yellow \"npm:dev:css\" \"npm:dev:sync\" \"npm:lab\"",
		"dev:sync": "browser-sync start --proxy localhost:2368 --port 3000 --ui-port 3001 --no-notify --files \"assets/built/screen.css\" \"**/*.hbs\"",
		"lab": "browser-sync start --server . --startPath /lab/ --port 3002 --ui-port 3003 --no-notify --files \"lab/**/*\" \"assets/built/screen.css\" \"assets/js/*.js\"",
		"ds:sync": "node .claude/skills/design-system/sync.mjs",
		"build": "npm run ds:sync && npm run build:css && npm run build:js",
		"build:css": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/built/screen.css --minify",
		"build:prod": "npm run build",
		"test": "gscan .",
		"test:fatal": "gscan . --fatal",
		"test:verbose": "gscan . --verbose",
		"clean": "rm -rf dist",
		"zip": "npm run build && npm run test:fatal && mkdir -p dist && zip -r -X dist/swarnil.zip . -x 'node_modules/*' 'dist/*' '.git/*' '.github/*' '.claude/*' 'lab/*' 'dummy-content/*' 'theme-customize.txt' 'instruction.md' 'documentation.md' 'redirects.yaml' '.DS_Store' '.gitignore'",
		"release": "npm run zip && echo '→ dist/swarnil.zip ready to upload (Ghost Admin → Design → Change theme → Upload)'",
		"build:js": "cp node_modules/creator-design-system/src/nav.js assets/js/nav.js && cp node_modules/creator-design-system/collection/collection.js assets/js/collection.js"
	},
	"config": {
		"custom": {
			"navbar_style": {
				"type": "select",
				"options": [
					"Full width, island on scroll",
					"Full width",
					"Full width, hides on scroll down",
					"Island"
				],
				"default": "Full width, island on scroll",
				"description": "A post can override this with #navbar-normal, #navbar-island or #navbar-reveal."
			}
		},
		"card_assets": true,
		"posts_per_page": 12,
		"image_sizes": {
			"100": {
				"width": 100
			},
			"300": {
				"width": 300
			},
			"600": {
				"width": 600
			},
			"1000": {
				"width": 1000
			},
			"1600": {
				"width": 1600
			},
			"2000": {
				"width": 2000
			}
		}
	},
	"devDependencies": {
		"browser-sync": "^3.0.4",
		"concurrently": "^10.0.3",
		"gscan": "^5.0.0",
		"tailwindcss": "^3.4.17"
	},
	"engines": {
		"ghost": ">=5.0.0"
	},
	"screenshots": {
		"desktop": "assets/screenshot-desktop.jpg"
	},
	"dependencies": {
		"creator-design-system": "file:../../../../Projects/Creator-Design-System"
	}
}
