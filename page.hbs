{{!< default}}

{{#post}}
	<article class="container-prose section">
		{{#if @page.show_title_and_feature_image}}
			<header class="stack u-mb-8">
				<h1 class="t-h1">{{title}}</h1>
				{{#if custom_excerpt}}
					<p class="t-lead">{{custom_excerpt}}</p>
				{{/if}}
			</header>

			{{#if feature_image}}
				<figure class="figure bleed-wide u-mb-8">
					<img src="{{img_url feature_image size="l"}}"
					     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
					     width="1000" height="563" />
				</figure>
			{{/if}}
		{{/if}}

		{{> post-body}}
	</article>
{{/post}}
