	<div class="hero hero-statement hero-sm">
		<span class="hero__eyebrow">Error {{statusCode}}</span>
		<h1 class="hero__title">{{message}}</h1>
		<p class="hero__lead">Something broke on my side. It's logged, and it'll show up in the changelog.</p>
		<div class="hero__actions">
			<a class="btn btn-primary btn-lg" href="{{@site.url}}/">Back home</a>
		</div>
	</div>
</section>
